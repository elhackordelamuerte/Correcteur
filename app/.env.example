# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service : serveur uniquement (page de scan sans compte). Ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA ---
# Fournisseur principal : gemini | openrouter. L'autre sert de secours s'il est configuré.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# URL publique de l'app (QR codes, redirections e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
